[TEMPLATE]
# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key (server-only — used by the market-price refresh job
# to write real DAM prices into the market_prices table). Never expose publicly.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional secret for triggering /api/refresh-prices manually
# (Vercel Cron automatically authenticates via its own vercel-cron user-agent)
CRON_SECRET=any-long-random-string

# OpenRouter AI (free tier — auto-rotates across keys on rate limit)
OPENROUTER_API_KEY=sk-or-v1-your-key
OPENROUTER_API_KEY_2=sk-or-v1-your-key-2
OPENROUTER_API_KEY_3=sk-or-v1-your-key-3
OPENROUTER_API_KEY_4=sk-or-v1-your-key-4

# OpenWeatherMap (free tier — 1000 calls/day)
OPENWEATHERMAP_API_KEY=your-api-key

# App URL (your Vercel deployment URL)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
